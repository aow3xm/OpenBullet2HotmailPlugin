<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Ob2Dir Condition="'$(Ob2Dir)' == ''">$(OB2_DIR)</Ob2Dir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RuriLib">
      <HintPath>$(Ob2Dir)/libraries/RuriLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateOb2Dir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Ob2Dir)' == '' or !Exists('$(Ob2Dir)/libraries/RuriLib.dll')"
           Text="RuriLib.dll was not found. Set -p:Ob2Dir=/path/to/OpenBullet2 or OB2_DIR to the OpenBullet2 directory containing libraries/RuriLib.dll." />
  </Target>
</Project>
